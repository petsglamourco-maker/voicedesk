{
  "name": "voicedesk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --continue",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @voicedesk/db generate",
    "db:migrate": "pnpm --filter @voicedesk/db migrate",
    "db:seed": "pnpm --filter @voicedesk/api seed",
    "test:e2e": "pnpm --filter @voicedesk/web test:e2e",
    "eval": "pnpm --filter @voicedesk/agent-brain eval",
    "tunnel": "node infra/tunnel.mjs",
    "mobile:lan": "node infra/mobile-lan.mjs",
    "push:keys": "pnpm --filter @voicedesk/api push:keys",
    "billing:prices": "pnpm --filter @voicedesk/api billing:prices",
    "billing:listen": "stripe listen --forward-to http://127.0.0.1:4000/api/webhooks/stripe --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
