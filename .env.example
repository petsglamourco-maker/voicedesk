# Copy to .env (never commit .env). Defaults match docker-compose.yml for local dev.

# ── Database ────────────────────────────────────────────────────────────────
# Runtime role: subject to Row-Level Security (NO BYPASSRLS).
DATABASE_URL=postgres://voicedesk_app:voicedesk_app_dev@127.0.0.1:5432/voicedesk
# Separate login for cross-business (platform) work only; see infra/postgres/platform-role.sql.
DATABASE_PLATFORM_URL=postgres://voicedesk_platform:voicedesk_platform_dev@127.0.0.1:5432/voicedesk
# Owner role: runs migrations and the seed script only.
DATABASE_OWNER_URL=postgres://voicedesk_owner:voicedesk_owner_dev@127.0.0.1:5432/voicedesk
# Separate database used by automated tests.
TEST_DATABASE_URL=postgres://voicedesk_app:voicedesk_app_dev@127.0.0.1:5432/voicedesk_test
TEST_DATABASE_PLATFORM_URL=postgres://voicedesk_platform:voicedesk_platform_dev@127.0.0.1:5432/voicedesk_test
TEST_DATABASE_OWNER_URL=postgres://voicedesk_owner:voicedesk_owner_dev@127.0.0.1:5432/voicedesk_test

# ── Redis / queues ──────────────────────────────────────────────────────────
# Valkey (Redis) password, used by docker-compose and inside REDIS_URL. Generate a random one.
VALKEY_PASSWORD=change-me-to-a-random-string
REDIS_URL=redis://:change-me-to-a-random-string@127.0.0.1:6379

# ── Object storage (SeaweedFS locally; AWS S3 eu-west-2 or R2 later) ────────────
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=voicedesk
S3_SECRET_ACCESS_KEY=voicedesk_dev_secret
S3_BUCKET=voicedesk-dev
S3_FORCE_PATH_STYLE=true

# ── Email (Mailpit locally: inbox UI at http://localhost:8025) ──────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="VoiceDesk <no-reply@voicedesk.local>"
# Real email (e.g. Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, your SMTP login and key;
# EMAIL_FROM must be a sender you verified there). Stand-in texts keep going to the local
# Mailpit at MAILPIT_SMTP_HOST:MAILPIT_SMTP_PORT (defaults localhost:1025).

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL the browser uses (the web app proxies /api/* to the API).
# Optional: its own key for OAuth state and website chat tokens (derived from BETTER_AUTH_SECRET if empty).
OAUTH_STATE_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Refuse passwords found in data breaches (Have I Been Pwned; only 5 characters of a hash are sent).
PASSWORD_BREACH_CHECK=on
# Proxies allowed to set X-Forwarded-For (comma-separated IPs/CIDRs). Locally: the Next.js dev server.
TRUSTED_PROXIES=127.0.0.1,::1

# ── Secrets at rest ─────────────────────────────────────────────────────────
# Encrypts secrets stored in the database (e.g. AI provider API keys). 32 random bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=
# Key ring: the current key's id, and old keys kept readable after a rotation (id:base64,...).
SETTINGS_ENCRYPTION_KEY_ID=k1
SETTINGS_ENCRYPTION_OLD_KEYS=

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Where the Next.js server forwards /api/* requests.
API_INTERNAL_URL=http://127.0.0.1:4000
WORKER_HEALTH_PORT=4100
LOG_LEVEL=info

# ── AI (Phase 1) ────────────────────────────────────────────────────────────
# AI providers are chosen in the app: Platform admin → AI providers.
# ANTHROPIC_API_KEY here is optional (the Claude provider can also store its key there).
# Set a monthly spend limit in the Anthropic Console before adding a key.
ANTHROPIC_API_KEY=
LLM_MODEL_REALTIME=claude-haiku-5-5
LLM_MODEL_REASONING=claude-sonnet-5-5
# local = free multilingual model on this machine (downloads ~120 MB once); mock = tests
EMBEDDINGS_PROVIDER=local
MODELS_CACHE_DIR=

# ── Seed ────────────────────────────────────────────────────────────────────
PLATFORM_OWNER_EMAIL=owner@voicedesk.local
PLATFORM_OWNER_PASSWORD=change-me-owner-password

# ── Providers (added in later phases — leave blank for now) ─────────────────
# TWILIO_ACCOUNT_SID=           # Phase 2
# TWILIO_AUTH_TOKEN=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# --- Voice (Phase 2, ADR 0013) ---------------------------------------------------------
# LiveKit Cloud project: Settings -> Keys. URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Deepgram (speech-to-text, Nova-3): console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=
# ElevenLabs (text-to-speech, Flash v2.5): elevenlabs.io -> Developers -> API Keys
ELEVENLABS_API_KEY=
# Voice worker health check port (GET /)
VOICE_AGENT_PORT=4200
# Phone calls (Phase 2b): optional comma-separated CIDRs allowed to send calls to our LiveKit
# SIP trunks, e.g. Twilio's published signalling ranges for your edge. Empty = any source
# (each trunk still only accepts calls to its own number).
SIP_ALLOWED_ADDRESSES=
# Phone calls via a Twilio TwiML Bin (<Dial><Sip username=… password=…>): choose a username
# and a long random password, put the same in the TwiML Bin, then run
# `pnpm --filter @voicedesk/api number:sync` so LiveKit requires them.
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
# Telnyx numbers: Telnyx sends calls without a SIP login, so their trunks only accept calls
# from Telnyx's signalling servers. Empty = the built-in Europe + US list (sip.telnyx.com).
TELNYX_SIP_ALLOWED_ADDRESSES=
# Outbound calls from the VA console (Phase 5; cost per minute, so switch on only when agreed).
# Twilio: Elastic SIP Trunking termination URI (e.g. voicedesk.pstn.twilio.com) + a credential list.
SIP_OUTBOUND_TWILIO_HOST=
SIP_OUTBOUND_TWILIO_USERNAME=
SIP_OUTBOUND_TWILIO_PASSWORD=
# Telnyx: a credentials connection's SIP username/password (host defaults to sip.telnyx.com).
SIP_OUTBOUND_TELNYX_HOST=
SIP_OUTBOUND_TELNYX_USERNAME=
SIP_OUTBOUND_TELNYX_PASSWORD=

# --- Calendar integrations (Phase 3, ADR 0014) ------------------------------------------
# Google Cloud OAuth client (Web application). Authorised redirect URI:
#   http://localhost:3000/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration (Outlook / Microsoft 365). Redirect URI (Web):
#   http://localhost:3000/api/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (default) accepts work and personal accounts; or a directory (tenant) id.
MICROSOFT_TENANT=

# --- WhatsApp (Phase 4, ADR 0017): Meta WhatsApp Cloud API ------------------------------
# Meta app → WhatsApp → API setup: access token (use a System User token for production).
WHATSAPP_ACCESS_TOKEN=
# Meta app → App settings → Basic → App secret (verifies webhook signatures).
WHATSAPP_APP_SECRET=
# Any long random string; enter the same value as "Verify token" in the webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0

# --- Bot check (security batch 4, ADR 0022): Cloudflare Turnstile, free ------------------
# Cloudflare dashboard → Turnstile → Add widget (your website address). Off while empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Phone testing over home Wi-Fi (Phase 7a, ADR 0024) ---------------------------------
# `pnpm mobile:lan` prints the address to put here (https, your PC's Wi-Fi address, :8443).
# Only https home-network addresses are accepted. Leave empty when not testing on a phone.
EXTRA_WEB_ORIGINS=

# --- Plans and billing (Phase 7a, ADR 0023): Stripe, test mode is free -------------------
# Card details never reach VoiceDesk (Stripe Checkout and the customer portal). Use test
# keys (sk_test_...) until launch. Billing is off while these are empty.
STRIPE_SECRET_KEY=
# From `pnpm billing:listen` (Stripe CLI, local) or the dashboard's webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Printed by `pnpm billing:prices`.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# --- Texts (Phase 3, ADR 0015) -----------------------------------------------------------
# mailpit (default): every SMS is delivered as an email to Mailpit, nothing is sent, free.
# twilio / telnyx: real texts (costs money). Only switch on when you've agreed the cost.
# A list tries them in order, e.g. telnyx,twilio (Telnyx first, Twilio if it fails).
SMS_PROVIDER=mailpit
# Sender shown on texts: up to 11 letters/digits (UK alphanumeric sender) or an E.164 number.
SMS_FROM=VoiceDesk
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Telnyx: API key (Portal → API Keys); the messaging profile is needed for a letters sender.
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
