# Copy to .env (never commit .env). Defaults match docker-compose.yml for local dev.

# ── Database ────────────────────────────────────────────────────────────────
# Runtime role: subject to Row-Level Security (NO BYPASSRLS).
DATABASE_URL=postgres://voicedesk_app:voicedesk_app_dev@localhost:5432/voicedesk
# Owner role: runs migrations and the seed script only.
DATABASE_OWNER_URL=postgres://voicedesk_owner:voicedesk_owner_dev@localhost:5432/voicedesk
# Separate database used by automated tests.
TEST_DATABASE_URL=postgres://voicedesk_app:voicedesk_app_dev@localhost:5432/voicedesk_test
TEST_DATABASE_OWNER_URL=postgres://voicedesk_owner:voicedesk_owner_dev@localhost:5432/voicedesk_test

# ── Redis / queues ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (SeaweedFS locally; AWS S3 eu-west-2 or R2 later) ────────────
S3_ENDPOINT=http://localhost:8333
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=voicedesk
S3_SECRET_ACCESS_KEY=voicedesk_dev_secret
S3_BUCKET=voicedesk-dev
S3_FORCE_PATH_STYLE=true

# ── Email (Mailpit locally: inbox UI at http://localhost:8025) ──────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="VoiceDesk <no-reply@voicedesk.local>"

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL the browser uses (the web app proxies /api/* to the API).
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Where the Next.js server forwards /api/* requests.
API_INTERNAL_URL=http://localhost:4000
WORKER_HEALTH_PORT=4100
LOG_LEVEL=info

# ── AI (Phase 1) ────────────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to run the agent against the mock LLM.
# Set a monthly spend limit in the Anthropic Console before adding a key.
ANTHROPIC_API_KEY=
LLM_MODEL_REALTIME=claude-haiku-5-5
LLM_MODEL_REASONING=claude-sonnet-5-5
# local = free multilingual model on this machine (downloads ~120 MB once); mock = tests
EMBEDDINGS_PROVIDER=local
MODELS_CACHE_DIR=

# ── Seed ────────────────────────────────────────────────────────────────────
PLATFORM_OWNER_EMAIL=owner@voicedesk.local
PLATFORM_OWNER_PASSWORD=change-me-owner-password

# ── Providers (added in later phases — leave blank for now) ─────────────────
# TWILIO_ACCOUNT_SID=           # Phase 2
# TWILIO_AUTH_TOKEN=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
